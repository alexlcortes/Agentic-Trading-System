OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper (default): https://paper-api.alpaca.markets
# Live (only after the Phase 9 checkpoint is genuinely satisfied — 4-8 weeks
# unattended paper validation, no bypassed risk checks, reasoning that holds
# up on review): https://api.alpaca.markets — with LIVE api/secret keys, never
# the paper ones. Never commit real live keys; this file only ever holds
# placeholders.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

TAVILY_API_KEY=

# Control flags (leave unset for safe defaults: auto_execute=False, kill_switch=False)
AUTO_EXECUTE=
KILL_SWITCH=

# Only used by run_daily.py when ALPACA_BASE_URL is live — starting position
# size cap for live trading, deliberately separate from and smaller than
# whatever max_position_pct was paper-validated. Default 0.01 (1/5 of the
# paper-tested 0.05) if unset.
LIVE_MAX_POSITION_PCT=

# Human-in-the-loop override for buys blocked solely by max_position_pct —
# see HUMAN_OVERRIDE_SETUP.md. Leave ENABLE_HUMAN_OVERRIDE unset/false until
# the n8n workflow below is built and reachable; a missing/unconfigured
# webhook always fails safe to "declined", never to "approved". n8n runs
# locally (started/stopped by scripts/run_daily_with_n8n.sh around each
# daily run), so this stays on localhost — never exposed to the internet.
ENABLE_HUMAN_OVERRIDE=
N8N_OVERRIDE_WEBHOOK_URL=http://localhost:5690/webhook/override-a1e9f2
N8N_OVERRIDE_SECRET=
OVERRIDE_TIMEOUT_SECONDS=600
