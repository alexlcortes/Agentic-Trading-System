#!/bin/zsh
# Runs the test suite before every commit, the golden test included once
# tests/golden/ exists. Enabled per clone with:
#     git config core.hooksPath .githooks
# Skip once with `git commit --no-verify`.
#
# Tests the working tree, not just what's staged: an unstaged fix can make a
# commit pass that wouldn't on its own.
#
# uv is looked up like the launchd jobs do: a GUI git client may not have it
# on PATH.
uv="${UV:-$(command -v uv || echo $HOME/.local/bin/uv)}"
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! "$uv" run pytest -q; then
    echo "pre-commit: tests failed — commit aborted (git commit --no-verify to skip)." >&2
    exit 1
fi
